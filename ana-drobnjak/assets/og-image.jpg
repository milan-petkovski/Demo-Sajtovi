<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <!-- Background -->
  <rect width="1200" height="630" fill="#FAF8F4"/>

  <!-- Decorative circle / blob -->
  <ellipse cx="950" cy="315" rx="340" ry="300" fill="#EAF3E5" opacity="0.7"/>
  <ellipse cx="280" cy="100" rx="180" ry="160" fill="#EAF3E5" opacity="0.4"/>

  <!-- Plate illustration -->
  <circle cx="920" cy="320" r="200" fill="#E8F0E4" opacity="0.6"/>
  <circle cx="920" cy="320" r="168" fill="#FAF8F4"/>
  <circle cx="920" cy="320" r="160" fill="none" stroke="#A8BFA0" stroke-width="2"/>
  <ellipse cx="920" cy="332" rx="90" ry="75" fill="#DBEBD3"/>
  <ellipse cx="920" cy="320" rx="90" ry="70" fill="#EAF3E5"/>

  <!-- Food dots -->
  <circle cx="905" cy="310" r="20" fill="#E8704A" opacity="0.85"/>
  <circle cx="938" cy="305" r="15" fill="#F4C882" opacity="0.9"/>
  <circle cx="922" cy="332" r="18" fill="#6A9E6F" opacity="0.8"/>
  <circle cx="898" cy="332" r="12" fill="#E8D4A0" opacity="0.85"/>
  <circle cx="944" cy="330" r="13" fill="#E8704A" opacity="0.55"/>

  <!-- Leaf left -->
  <path d="M766 276 Q740 252 750 236 Q778 246 784 272 Q776 276 766 276Z" fill="#6A9E6F" opacity="0.75"/>
  <!-- Leaf right -->
  <path d="M1074 276 Q1100 252 1090 236 Q1062 246 1056 272 Q1064 276 1074 276Z" fill="#6A9E6F" opacity="0.75"/>

  <!-- Text content -->
  <text x="120" y="220" font-family="Georgia, serif" font-size="20" fill="#A8BFA0" letter-spacing="4" font-weight="600" text-anchor="start">NUTRICIONISTA</text>
  <text x="116" y="320" font-family="Georgia, serif" font-size="72" fill="#1F3D2B" font-weight="600" text-anchor="start" letter-spacing="-2">Ana Drobnjak</text>
  <text x="120" y="390" font-family="Georgia, serif" font-size="30" fill="#6A9E6F" font-style="italic" text-anchor="start">Jelovnik po meri za tebe</text>
  <text x="120" y="450" font-family="Arial, sans-serif" font-size="18" fill="#6A7B6F" text-anchor="start">Online narudžbina &bull; Isporuka za 48h &bull; Individualni pristup</text>
</svg>
